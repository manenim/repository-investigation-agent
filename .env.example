# Never commit real values. Required for live generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ACCESS_TOKEN=
DB_PATH=data/investigations.sqlite3
# snapshot is explicit offline SAMPLE mode; github uses live REST ingestion
SOURCE_MODE=github
PROVIDER=openai
MAX_DAILY_RUNS=20
MAX_STORED_RUNS=200

# Hosted Postgres overrides DB_PATH; never use SQLite on an ephemeral host.
DATABASE_URL=
DEPLOYMENT_NOTICE=
